 /* **** */
+/* Safe extraction guard added for this one untrusted vendor archive. */
+int safe_relative(const char *path) {
+    const char *p = path, *seg;
+    if (!p || !*p || *p == '/' || *p == '\\' || (p[0] && p[1] == ':')) return 0;
+    while (*p) {
+        seg = p;
+        while (*p && *p != '/' && *p != '\\') { if (*p == ':') return 0; p++; }
+        if ((p - seg) == 2 && seg[0] == '.' && seg[1] == '.') return 0;
+        if ((p - seg) == 1 && seg[0] == '.') return 0;
+        if (*p) p++;
+    }
+    return 1;
+}
