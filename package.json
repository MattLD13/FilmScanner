{
  "name": "frame-workspace",
  "private": true,
  "scripts": {
    "start": "python -m uvicorn services.api.main:app --host 127.0.0.1 --port 8765",
    "build": "npm --prefix apps/web run build",
    "test": "python -m pytest -q",
    "lint": "npm --prefix apps/web run lint",
    "setup": "python -m pip install -r requirements.txt && npm --prefix apps/web install"
  }
}
